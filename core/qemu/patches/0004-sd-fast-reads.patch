-#define SDHC_ADMA_DESCS_PER_DELAY       5
+/*
+ * Descriptors handled before the rest of an ADMA transfer is deferred to
+ * the transfer timer. The deferral costs a main-loop wakeup, a millisecond
+ * or more on Windows: with drivers that describe 4 KiB in 512-byte
+ * descriptors (NXP's MCUXpresso SDK) every read paid it. Transfers are
+ * copies within guest RAM; finish them at once.
+ */
+#define SDHC_ADMA_DESCS_PER_DELAY       1024
