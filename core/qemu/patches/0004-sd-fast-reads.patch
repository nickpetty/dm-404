+#define SD_RCACHE_SIZE (256 * KiB)
+
 static void sd_blk_read(SDState *sd, uint64_t addr, uint32_t len)
 {
     trace_sdcard_read_block(addr, len);
     addr += sd_part_offset(sd);
+    if (sd->blk && len <= SD_RCACHE_SIZE) {
+        if (!(sd->rcache_len && addr >= sd->rcache_addr &&
+              addr + len <= sd->rcache_addr + sd->rcache_len)) {
+            int64_t size = blk_getlength(sd->blk);
+            uint64_t start = QEMU_ALIGN_DOWN(addr, 512);
+            uint64_t n = SD_RCACHE_SIZE;
+
+            if (!sd->rcache) {
+                sd->rcache = g_malloc(SD_RCACHE_SIZE);
+            }
+            if (size > 0 && start + n > (uint64_t)size) {
+                n = (uint64_t)size > start ? size - start : 0;
+            }
+            sd->rcache_len = 0;
+            if (n < addr - start + len ||
+                blk_pread(sd->blk, start, n, sd->rcache, 0) < 0) {
+                goto direct;
+            }
+            sd->rcache_addr = start;
+            sd->rcache_len = n;
+        }
+        memcpy(sd->data, sd->rcache + (addr - sd->rcache_addr), len);
+        return;
+    }
+direct:
     if (!sd->blk || blk_pread(sd->blk, addr, len, sd->data, 0) < 0) {
         fprintf(stderr, "sd_blk_read: read error on host side\n");
     }
